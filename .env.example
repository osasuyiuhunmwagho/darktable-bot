# Copy to .env. DRIVE_ROOT_FOLDER_ID is required; the rest are optional overrides for constants.py.

# Parent Drive folder that shoot folders get added to (ID or full URL)
DRIVE_ROOT_FOLDER_ID=PASTE_DRIVE_FOLDER_URL_OR_ID
# OUTPUT_SUBFOLDER_NAME=Edited

# darktable
# DARKTABLE_CLI=C:\Program Files\darktable\bin\darktable-cli.exe
# Name of a style you've created in darktable
# DARKTABLE_STYLE=
# Your normal darktable config (usually C:\Users\<you>\AppData\Local\darktable) so styles exist.
# Close the darktable GUI while the script runs if you set this.
# DARKTABLE_CONFIG_DIR=

# Export
# OUTPUT_FORMAT=jpg
# OUTPUT_MAX_WIDTH=0
# OUTPUT_MAX_HEIGHT=0
